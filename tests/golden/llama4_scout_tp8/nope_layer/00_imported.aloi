module @llama4_scout

func @forward(%input_layernorm.weight: tensor<5120xbf16>, %self_attn.q_proj.weight: tensor<5120x5120xbf16>, %self_attn.k_proj.weight: tensor<1024x5120xbf16>, %self_attn.v_proj.weight: tensor<1024x5120xbf16>, %self_attn.o_proj.weight: tensor<5120x5120xbf16>, %post_attention_layernorm.weight: tensor<5120xbf16>, %feed_forward.router.weight: tensor<16x5120xbf16>, %feed_forward.experts.gate_proj: tensor<16x8192x5120xbf16>, %feed_forward.experts.up_proj: tensor<16x8192x5120xbf16>, %feed_forward.experts.down_proj: tensor<16x5120x8192xbf16>, %feed_forward.shared_expert.gate_proj.weight: tensor<8192x5120xbf16>, %feed_forward.shared_expert.up_proj.weight: tensor<8192x5120xbf16>, %feed_forward.shared_expert.down_proj.weight: tensor<5120x8192xbf16>, %x: tensor<1x1x5120xbf16>, %positions: tensor<1x1xint64>, %k_cache: tensor<1x2048x8x128xbf16>, %v_cache: tensor<1x2048x8x128xbf16>) -> (tensor<1x1x5120xbf16>, tensor<1x2048x8x128xbf16>, tensor<1x2048x8x128xbf16>) {
  %input_layernorm = aloi.rms_norm(%x, %input_layernorm.weight) {eps = 1e-05} : tensor<1x1x5120xbf16>
  %self_attn.q_proj = aloi.linear(%input_layernorm, %self_attn.q_proj.weight) : tensor<1x1x5120xbf16>
  %self_attn.split_heads = aloi.split_heads(%self_attn.q_proj) {head_dim = 128} : tensor<1x1x40x128xbf16>
  %self_attn.k_proj = aloi.linear(%input_layernorm, %self_attn.k_proj.weight) : tensor<1x1x1024xbf16>
  %self_attn.split_heads_1 = aloi.split_heads(%self_attn.k_proj) {head_dim = 128} : tensor<1x1x8x128xbf16>
  %self_attn.v_proj = aloi.linear(%input_layernorm, %self_attn.v_proj.weight) : tensor<1x1x1024xbf16>
  %self_attn.split_heads_2 = aloi.split_heads(%self_attn.v_proj) {head_dim = 128} : tensor<1x1x8x128xbf16>
  %self_attn.attn_temperature = aloi.attn_temperature(%self_attn.split_heads, %positions) {floor_scale = 8192.0, attn_scale = 0.1} : tensor<1x1x40x128xbf16>
  %self_attn.kv_update = aloi.kv_update(%k_cache, %self_attn.split_heads_1, %positions) : tensor<1x2048x8x128xbf16>
  %self_attn.kv_update_1 = aloi.kv_update(%v_cache, %self_attn.split_heads_2, %positions) : tensor<1x2048x8x128xbf16>
  %self_attn.gqa_qk = aloi.gqa_qk(%self_attn.attn_temperature, %self_attn.kv_update) {scale = 0.08838834764831845} : tensor<1x1x40x2048xbf16>
  %self_attn.softmax = aloi.softmax(%self_attn.gqa_qk) : tensor<1x1x40x2048xbf16>
  %self_attn.gqa_sv = aloi.gqa_sv(%self_attn.softmax, %self_attn.kv_update_1) : tensor<1x1x40x128xbf16>
  %self_attn.merge_heads = aloi.merge_heads(%self_attn.gqa_sv) : tensor<1x1x5120xbf16>
  %self_attn.o_proj = aloi.linear(%self_attn.merge_heads, %self_attn.o_proj.weight) : tensor<1x1x5120xbf16>
  %add = aloi.add(%x, %self_attn.o_proj) : tensor<1x1x5120xbf16>
  %post_attention_layernorm = aloi.rms_norm(%add, %post_attention_layernorm.weight) {eps = 1e-05} : tensor<1x1x5120xbf16>
  %feed_forward.router = aloi.linear(%post_attention_layernorm, %feed_forward.router.weight) : tensor<1x1x16xbf16>
  %feed_forward.topk_sigmoid = aloi.topk_sigmoid(%feed_forward.router) {top_k = 1} : tensor<1x1x16xbf16>
  %feed_forward.experts = aloi.moe_experts(%post_attention_layernorm, %feed_forward.topk_sigmoid, %feed_forward.experts.gate_proj, %feed_forward.experts.up_proj, %feed_forward.experts.down_proj) {apply_router_weight_on_input = true} : tensor<1x1x5120xbf16>
  %feed_forward.shared_expert.gate_proj = aloi.linear(%post_attention_layernorm, %feed_forward.shared_expert.gate_proj.weight) : tensor<1x1x8192xbf16>
  %feed_forward.shared_expert.up_proj = aloi.linear(%post_attention_layernorm, %feed_forward.shared_expert.up_proj.weight) : tensor<1x1x8192xbf16>
  %feed_forward.shared_expert.silu = aloi.activation(%feed_forward.shared_expert.gate_proj) {function = silu} : tensor<1x1x8192xbf16>
  %feed_forward.shared_expert.mul = aloi.mul(%feed_forward.shared_expert.silu, %feed_forward.shared_expert.up_proj) : tensor<1x1x8192xbf16>
  %feed_forward.shared_expert.down_proj = aloi.linear(%feed_forward.shared_expert.mul, %feed_forward.shared_expert.down_proj.weight) : tensor<1x1x5120xbf16>
  %feed_forward.add_1 = aloi.add(%feed_forward.experts, %feed_forward.shared_expert.down_proj) : tensor<1x1x5120xbf16>
  %add_2 = aloi.add(%add, %feed_forward.add_1) : tensor<1x1x5120xbf16>
  return %add_2, %self_attn.kv_update, %self_attn.kv_update_1
}
