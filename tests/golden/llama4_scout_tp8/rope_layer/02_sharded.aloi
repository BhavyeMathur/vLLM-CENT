module @llama4_scout

func @forward(%input_layernorm.weight: tensor<5120xbf16, role=weight, axes=[hidden]>, %self_attn.q_proj.weight: tensor<640x5120xbf16, role=weight, axes=[q_head*head_dim, hidden], global_shape=5120x5120, placement=shard(q_head)>, %self_attn.k_proj.weight: tensor<128x5120xbf16, role=weight, axes=[kv_head*head_dim, hidden], global_shape=1024x5120, placement=shard(kv_head)>, %self_attn.v_proj.weight: tensor<128x5120xbf16, role=weight, axes=[kv_head*head_dim, hidden], global_shape=1024x5120, placement=shard(kv_head)>, %self_attn.o_proj.weight: tensor<5120x640xbf16, role=weight, axes=[hidden, q_head*head_dim], global_shape=5120x5120, placement=shard(q_head)>, %post_attention_layernorm.weight: tensor<5120xbf16, role=weight, axes=[hidden]>, %feed_forward.router.weight: tensor<16x5120xbf16, role=weight, axes=[expert, hidden]>, %feed_forward.experts.gate_proj: tensor<16x1024x5120xbf16, role=weight, axes=[expert, intermediate, hidden], global_shape=16x8192x5120, placement=shard(intermediate)>, %feed_forward.experts.up_proj: tensor<16x1024x5120xbf16, role=weight, axes=[expert, intermediate, hidden], global_shape=16x8192x5120, placement=shard(intermediate)>, %feed_forward.experts.down_proj: tensor<16x5120x1024xbf16, role=weight, axes=[expert, hidden, intermediate], global_shape=16x5120x8192, placement=shard(intermediate)>, %feed_forward.shared_expert.gate_proj.weight: tensor<1024x5120xbf16, role=weight, axes=[intermediate, hidden], global_shape=8192x5120, placement=shard(intermediate)>, %feed_forward.shared_expert.up_proj.weight: tensor<1024x5120xbf16, role=weight, axes=[intermediate, hidden], global_shape=8192x5120, placement=shard(intermediate)>, %feed_forward.shared_expert.down_proj.weight: tensor<5120x1024xbf16, role=weight, axes=[hidden, intermediate], global_shape=5120x8192, placement=shard(intermediate)>, %self_attn.rotary_emb.cos_sin_cache: tensor<10485760x128xbf16, role=weight, axes=[position, rotary_dim]>, %x: tensor<1x1x5120xbf16, axes=[batch, seq_len, hidden]>, %positions: tensor<1x1xint64, axes=[batch, seq_len]>, %k_cache: tensor<1x2048x1x128xbf16, role=kv_cache, axes=[batch, context, kv_head, head_dim], global_shape=1x2048x8x128, placement=shard(kv_head)>, %v_cache: tensor<1x2048x1x128xbf16, role=kv_cache, axes=[batch, context, kv_head, head_dim], global_shape=1x2048x8x128, placement=shard(kv_head)>) -> (tensor<1x1x5120xbf16, axes=[batch, seq_len, hidden]>, tensor<1x2048x1x128xbf16, role=kv_cache, axes=[batch, context, kv_head, head_dim], global_shape=1x2048x8x128, placement=shard(kv_head)>, tensor<1x2048x1x128xbf16, role=kv_cache, axes=[batch, context, kv_head, head_dim], global_shape=1x2048x8x128, placement=shard(kv_head)>) {
  %input_layernorm = aloi.rms_norm(%x, %input_layernorm.weight) {eps = 1e-05} : tensor<1x1x5120xbf16, axes=[batch, seq_len, hidden]>
  %self_attn.q_proj = aloi.linear(%input_layernorm, %self_attn.q_proj.weight) : tensor<1x1x640xbf16, axes=[batch, seq_len, q_head*head_dim], global_shape=1x1x5120, placement=shard(q_head)>
  %self_attn.split_heads = aloi.split_heads(%self_attn.q_proj) {head_dim = 128} : tensor<1x1x5x128xbf16, axes=[batch, seq_len, q_head, head_dim], global_shape=1x1x40x128, placement=shard(q_head)>
  %self_attn.k_proj = aloi.linear(%input_layernorm, %self_attn.k_proj.weight) : tensor<1x1x128xbf16, axes=[batch, seq_len, kv_head*head_dim], global_shape=1x1x1024, placement=shard(kv_head)>
  %self_attn.split_heads_1 = aloi.split_heads(%self_attn.k_proj) {head_dim = 128} : tensor<1x1x1x128xbf16, axes=[batch, seq_len, kv_head, head_dim], global_shape=1x1x8x128, placement=shard(kv_head)>
  %self_attn.v_proj = aloi.linear(%input_layernorm, %self_attn.v_proj.weight) : tensor<1x1x128xbf16, axes=[batch, seq_len, kv_head*head_dim], global_shape=1x1x1024, placement=shard(kv_head)>
  %self_attn.split_heads_2 = aloi.split_heads(%self_attn.v_proj) {head_dim = 128} : tensor<1x1x1x128xbf16, axes=[batch, seq_len, kv_head, head_dim], global_shape=1x1x8x128, placement=shard(kv_head)>
  %self_attn.rotary_emb.rope = aloi.rope(%self_attn.split_heads, %positions, %self_attn.rotary_emb.cos_sin_cache) {is_neox_style = false} : tensor<1x1x5x128xbf16, axes=[batch, seq_len, q_head, head_dim], global_shape=1x1x40x128, placement=shard(q_head)>
  %self_attn.rotary_emb.rope_1 = aloi.rope(%self_attn.split_heads_1, %positions, %self_attn.rotary_emb.cos_sin_cache) {is_neox_style = false} : tensor<1x1x1x128xbf16, axes=[batch, seq_len, kv_head, head_dim], global_shape=1x1x8x128, placement=shard(kv_head)>
  %self_attn.qk_norm.rms_norm_1 = aloi.rms_norm(%self_attn.rotary_emb.rope) {eps = 1e-05} : tensor<1x1x5x128xbf16, axes=[batch, seq_len, q_head, head_dim], global_shape=1x1x40x128, placement=shard(q_head)>
  %self_attn.qk_norm.rms_norm_2 = aloi.rms_norm(%self_attn.rotary_emb.rope_1) {eps = 1e-05} : tensor<1x1x1x128xbf16, axes=[batch, seq_len, kv_head, head_dim], global_shape=1x1x8x128, placement=shard(kv_head)>
  %self_attn.kv_update = aloi.kv_update(%k_cache, %self_attn.qk_norm.rms_norm_2, %positions) : tensor<1x2048x1x128xbf16, role=kv_cache, axes=[batch, context, kv_head, head_dim], global_shape=1x2048x8x128, placement=shard(kv_head)>
  %self_attn.kv_update_1 = aloi.kv_update(%v_cache, %self_attn.split_heads_2, %positions) : tensor<1x2048x1x128xbf16, role=kv_cache, axes=[batch, context, kv_head, head_dim], global_shape=1x2048x8x128, placement=shard(kv_head)>
  %self_attn.gqa_qk = aloi.gqa_qk(%self_attn.qk_norm.rms_norm_1, %self_attn.kv_update) {scale = 0.08838834764831845} : tensor<1x1x5x2048xbf16, axes=[batch, seq_len, q_head, context], global_shape=1x1x40x2048, placement=shard(q_head)>
  %self_attn.softmax = aloi.softmax(%self_attn.gqa_qk) : tensor<1x1x5x2048xbf16, axes=[batch, seq_len, q_head, context], global_shape=1x1x40x2048, placement=shard(q_head)>
  %self_attn.gqa_sv = aloi.gqa_sv(%self_attn.softmax, %self_attn.kv_update_1) : tensor<1x1x5x128xbf16, axes=[batch, seq_len, q_head, head_dim], global_shape=1x1x40x128, placement=shard(q_head)>
  %self_attn.merge_heads = aloi.merge_heads(%self_attn.gqa_sv) : tensor<1x1x640xbf16, axes=[batch, seq_len, q_head*head_dim], global_shape=1x1x5120, placement=shard(q_head)>
  %self_attn.o_proj = aloi.linear(%self_attn.merge_heads, %self_attn.o_proj.weight) : tensor<1x1x5120xbf16, axes=[batch, seq_len, hidden], placement=partial>
  %self_attn.o_proj_1 = aloi.all_reduce(%self_attn.o_proj) : tensor<1x1x5120xbf16, axes=[batch, seq_len, hidden]>
  %add = aloi.add(%x, %self_attn.o_proj_1) : tensor<1x1x5120xbf16, axes=[batch, seq_len, hidden]>
  %post_attention_layernorm = aloi.rms_norm(%add, %post_attention_layernorm.weight) {eps = 1e-05} : tensor<1x1x5120xbf16, axes=[batch, seq_len, hidden]>
  %feed_forward.router = aloi.linear(%post_attention_layernorm, %feed_forward.router.weight) : tensor<1x1x16xbf16, axes=[batch, seq_len, expert]>
  %feed_forward.topk_sigmoid = aloi.topk_sigmoid(%feed_forward.router) {top_k = 1} : tensor<1x1x16xbf16, axes=[batch, seq_len, expert]>
  %feed_forward.experts = aloi.moe_experts(%post_attention_layernorm, %feed_forward.topk_sigmoid, %feed_forward.experts.gate_proj, %feed_forward.experts.up_proj, %feed_forward.experts.down_proj) {apply_router_weight_on_input = true} : tensor<1x1x5120xbf16, axes=[batch, seq_len, hidden], placement=partial>
  %feed_forward.experts_1 = aloi.all_reduce(%feed_forward.experts) : tensor<1x1x5120xbf16, axes=[batch, seq_len, hidden]>
  %feed_forward.shared_expert.gate_proj = aloi.linear(%post_attention_layernorm, %feed_forward.shared_expert.gate_proj.weight) : tensor<1x1x1024xbf16, axes=[batch, seq_len, intermediate], global_shape=1x1x8192, placement=shard(intermediate)>
  %feed_forward.shared_expert.up_proj = aloi.linear(%post_attention_layernorm, %feed_forward.shared_expert.up_proj.weight) : tensor<1x1x1024xbf16, axes=[batch, seq_len, intermediate], global_shape=1x1x8192, placement=shard(intermediate)>
  %feed_forward.shared_expert.silu = aloi.activation(%feed_forward.shared_expert.gate_proj) {function = silu} : tensor<1x1x1024xbf16, axes=[batch, seq_len, intermediate], global_shape=1x1x8192, placement=shard(intermediate)>
  %feed_forward.shared_expert.mul = aloi.mul(%feed_forward.shared_expert.silu, %feed_forward.shared_expert.up_proj) : tensor<1x1x1024xbf16, axes=[batch, seq_len, intermediate], global_shape=1x1x8192, placement=shard(intermediate)>
  %feed_forward.shared_expert.down_proj = aloi.linear(%feed_forward.shared_expert.mul, %feed_forward.shared_expert.down_proj.weight) : tensor<1x1x5120xbf16, axes=[batch, seq_len, hidden], placement=partial>
  %feed_forward.shared_expert.down_proj_1 = aloi.all_reduce(%feed_forward.shared_expert.down_proj) : tensor<1x1x5120xbf16, axes=[batch, seq_len, hidden]>
  %feed_forward.add_1 = aloi.add(%feed_forward.experts_1, %feed_forward.shared_expert.down_proj_1) : tensor<1x1x5120xbf16, axes=[batch, seq_len, hidden]>
  %add_2 = aloi.add(%add, %feed_forward.add_1) : tensor<1x1x5120xbf16, axes=[batch, seq_len, hidden]>
  return %add_2, %self_attn.kv_update, %self_attn.kv_update_1
}
