# CENT's AiM trace of one Llama 70B decoder layer (Llama 3.1 70B shapes),
# generated by CENT's simulator, ../ALOI/cent_simulation at f6d0549, with
#   python function_sim.py --Llama-GQA --n_heads 64 --ffn_dim 28672 \
#     --only-trace --num-channels 32 --num-banks 16 --max-seq-len 4096 \
#     --FC-devices 8 --model-parallel --seqlen 2304 --op-trace \
#     --GEMV reuse-GB --reuse-size 32 --kv-head-tp --tp-device-role main \
#     --precision bf16 --DRAM-column 1024 --burst-length 16 --trace-file <this>
