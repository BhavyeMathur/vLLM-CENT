  %self_attn.softmax.sum_rows = device.broadcast(%self_attn.softmax.sum) {size = 2048, axis = "context"} : tensor<1x1x8x2048xbf16, axes=[batch, seq_len, q_head, context], global_shape=1x1x64x2048, placement=shard(q_head), domain=pnm>
