  %self_attn.softmax.shifted = pnm.sub(%7, %self_attn.softmax.max_rows) : tensor<1x1x8x2048xbf16, axes=[batch, seq_len, q_head, context], global_shape=1x1x64x2048, placement=shard(q_head), domain=pnm>
