  %self_attn.kv_update = aloi.kv_update(%k_cache, %self_attn.rotary_emb.rope_1, %positions) : tensor<1x2048x1x128xbf16, role=kv_cache, axes=[batch, context, kv_head, head_dim], global_shape=1x2048x8x128, placement=shard(kv_head)>
  %self_attn.kv_update_1 = aloi.kv_update(%v_cache, %self_attn.split_heads_2, %positions) : tensor<1x2048x1x128xbf16, role=kv_cache, axes=[batch, context, kv_head, head_dim], global_shape=1x2048x8x128, placement=shard(kv_head)>
  %self_attn.gqa_qk = aloi.gqa_qk(%self_attn.rotary_emb.rope, %self_attn.kv_update) {scale = 0.08838834764831845} : tensor<1x1x8x2048xbf16, axes=[batch, seq_len, q_head, context], global_shape=1x1x64x2048, placement=shard(q_head)>
  %self_attn.softmax = aloi.softmax(%self_attn.gqa_qk) : tensor<1x1x8x2048xbf16, axes=[batch, seq_len, q_head, context], global_shape=1x1x64x2048, placement=shard(q_head)>
  %self_attn.gqa_sv = aloi.gqa_sv(%self_attn.softmax, %self_attn.kv_update_1) : tensor<1x1x8x128xbf16, axes=[batch, seq_len, q_head, head_dim], global_shape=1x1x64x128, placement=shard(q_head)>
  %self_attn.merge_heads = aloi.merge_heads(%self_attn.gqa_sv) : tensor<1x1x1024xbf16, axes=[batch, seq_len, q_head*head_dim], global_shape=1x1x8192, placement=shard(q_head)>
  %self_attn.o_proj = aloi.linear(%self_attn.merge_heads, %self_attn.o_proj.weight) : tensor<1x1x8192xbf16, axes=[batch, seq_len, hidden], placement=partial>
  %self_attn.o_proj_1 = aloi.all_reduce(%self_attn.o_proj) : tensor<1x1x8192xbf16, axes=[batch, seq_len, hidden]>
  %add = aloi.add(%x, %self_attn.o_proj_1) : tensor<1x1x8192xbf16, axes=[batch, seq_len, hidden]>
  %post_attention_layernorm = aloi.rms_norm(%add, %post_attention_layernorm.weight) {eps = 1e-05} : tensor<1x1x8192xbf16, axes=[batch, seq_len, hidden]>
  %mlp.gate_proj = aloi.linear(%post_attention_layernorm, %mlp.gate_proj.weight) : tensor<1x1x3584xbf16, axes=[batch, seq_len, intermediate], global_shape=1x1x28672, placement=shard(intermediate)>
  %mlp.up_proj = aloi.linear(%post_attention_layernorm, %mlp.up_proj.weight) : tensor<1x1x3584xbf16, axes=[batch, seq_len, intermediate], global_shape=1x1x28672, placement=shard(intermediate)>
  %mlp.silu = aloi.activation(%mlp.gate_proj) {function = silu} : tensor<1x1x3584xbf16, axes=[batch, seq_len, intermediate], global_shape=1x1x28672, placement=shard(intermediate)>
  %mlp.mul = aloi.mul(%mlp.silu, %mlp.up_proj) : tensor<1x1x3584xbf16, axes=[batch, seq_len, intermediate], global_shape=1x1x28672, placement=shard(intermediate)>
  %mlp.down_proj = aloi.linear(%mlp.mul, %mlp.down_proj.weight) : tensor<1x1x8192xbf16, axes=[batch, seq_len, hidden], placement=partial>
  %mlp.down_proj_1 = aloi.all_reduce(%mlp.down_proj) : tensor<1x1x8192xbf16, axes=[batch, seq_len, hidden]>
  %add_1 = aloi.add(%add, %mlp.down_proj_1) : tensor<1x1x8192xbf16, axes=[batch, seq_len, hidden]>
  return %add_1, %self_attn.kv_update, %self_attn.kv_update_1
