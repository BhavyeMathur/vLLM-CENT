module @llama3_1_70b_decoder_layer

func @forward(%input_layernorm.weight: tensor<8192xbf16, role=weight, axes=[hidden]>, %self_attn.q_proj.weight: tensor<1024x8192xbf16, role=weight, axes=[q_head*head_dim, hidden], global_shape=8192x8192, placement=shard(q_head)>, %self_attn.k_proj.weight: tensor<128x8192xbf16, role=weight, axes=[kv_head*head_dim, hidden], global_shape=1024x8192, placement=shard(kv_head)>, %self_attn.v_proj.weight: tensor<128x8192xbf16, role=weight, axes=[kv_head*head_dim, hidden], global_shape=1024x8192, placement=shard(kv_head)>, %self_attn.o_proj.weight: tensor<8192x1024xbf16, role=weight, axes=[hidden, q_head*head_dim], global_shape=8192x8192, placement=shard(q_head)>, %post_attention_layernorm.weight: tensor<8192xbf16, role=weight, axes=[hidden]>, %mlp.gate_proj.weight: tensor<3584x8192xbf16, role=weight, axes=[intermediate, hidden], global_shape=28672x8192, placement=shard(intermediate)>, %mlp.up_proj.weight: tensor<3584x8192xbf16, role=weight, axes=[intermediate, hidden], global_shape=28672x8192, placement=shard(intermediate)>, %mlp.down_proj.weight: tensor<8192x3584xbf16, role=weight, axes=[hidden, intermediate], global_shape=8192x28672, placement=shard(intermediate)>, %self_attn.rotary_emb.cos_sin_cache: tensor<131072x128xbf16, role=weight, axes=[position, rotary_dim]>, %x: tensor<1x1x8192xbf16, axes=[batch, seq_len, hidden]>, %positions: tensor<1x1xint64, axes=[batch, seq_len]>, %k_cache: tensor<1x2048x1x128xbf16, role=kv_cache, axes=[batch, context, kv_head, head_dim], global_shape=1x2048x8x128, placement=shard(kv_head)>, %v_cache: tensor<1x2048x1x128xbf16, role=kv_cache, axes=[batch, context, kv_head, head_dim], global_shape=1x2048x8x128, placement=shard(kv_head)>) -> (tensor<1x1x8192xbf16, axes=[batch, seq_len, hidden]>, tensor<1x2048x1x128xbf16, role=kv_cache, axes=[batch, context, kv_head, head_dim], global_shape=1x2048x8x128, placement=shard(kv_head)>, tensor<1x2048x1x128xbf16, role=kv_cache, axes=[batch, context, kv_head, head_dim], global_shape=1x2048x8x128, placement=shard(kv_head)>) {
  %input_layernorm = aloi.rms_norm(%x, %input_layernorm.weight) {eps = 1e-05} : tensor<1x1x8192xbf16, axes=[batch, seq_len, hidden]>
  %self_attn.q_proj = aloi.linear(%input_layernorm, %self_attn.q_proj.weight) : tensor<1x1x1024xbf16, axes=[batch, seq_len, q_head*head_dim], global_shape=1x1x8192, placement=shard(q_head)>
  %self_attn.split_heads = aloi.split_heads(%self_attn.q_proj) {head_dim = 128} : tensor<1x1x8x128xbf16, axes=[batch, seq_len, q_head, head_dim], global_shape=1x1x64x128, placement=shard(q_head)>
  %self_attn.k_proj = aloi.linear(%input_layernorm, %self_attn.k_proj.weight) : tensor<1x1x128xbf16, axes=[batch, seq_len, kv_head*head_dim], global_shape=1x1x1024, placement=shard(kv_head)>
  %self_attn.split_heads_1 = aloi.split_heads(%self_attn.k_proj) {head_dim = 128} : tensor<1x1x1x128xbf16, axes=[batch, seq_len, kv_head, head_dim], global_shape=1x1x8x128, placement=shard(kv_head)>
  %self_attn.v_proj = aloi.linear(%input_layernorm, %self_attn.v_proj.weight) : tensor<1x1x128xbf16, axes=[batch, seq_len, kv_head*head_dim], global_shape=1x1x1024, placement=shard(kv_head)>
  %self_attn.split_heads_2 = aloi.split_heads(%self_attn.v_proj) {head_dim = 128} : tensor<1x1x1x128xbf16, axes=[batch, seq_len, kv_head, head_dim], global_shape=1x1x8x128, placement=shard(kv_head)>
  %self_attn.rotary_emb.rope = aloi.rope(%self_attn.split_heads, %positions, %self_attn.rotary_emb.cos_sin_cache) {is_neox_style = true} : tensor<1x1x8x128xbf16, axes=[batch, seq_len, q_head, head_dim], global_shape=1x1x64x128, placement=shard(q_head)>
