// layout %p: pnm.sb slot 0: h=(Serial h 8), s=(Serial shard 3, Slot 64, Lane 16)
// layout %v_cache: pim.dram row 42: s=(Channel 4, Column 1024), d=(Channel 8, Bank 16)
