// pnm.add (add_1)
// layout %residual: pnm.sb slot 0: n=(Slot 512, Lane 16)
// layout %update: pnm.sb slot 512: n=(Slot 512, Lane 16)
func @add_1(%residual: tensor<8192xbf16, domain=pnm, memory_space=pnm.sb>, %update: tensor<8192xbf16, domain=pnm, memory_space=pnm.sb>) -> (tensor<8192xbf16, domain=pnm, memory_space=pnm.sb>) {
  %residual_1 = cent.ewadd(%residual, %update) : tensor<8192xbf16, domain=pnm, memory_space=pnm.sb>
  return %residual_1
}
