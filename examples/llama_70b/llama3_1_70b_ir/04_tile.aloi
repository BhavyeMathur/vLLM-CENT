  %ew_a_1 = cent.wr_mem(%gate, %ew_a) {start = [0]} : tensor<3584xbf16, domain=pim, memory_space=pim.dram>
  %ew_b_1 = cent.wr_mem(%sigmoid, %ew_b) {start = [0]} : tensor<3584xbf16, domain=pim, memory_space=pim.dram>
