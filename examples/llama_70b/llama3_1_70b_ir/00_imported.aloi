module @llama3_1_70b_decoder_layer

func @forward(%input_layernorm.weight: tensor<8192xbf16>, %self_attn.q_proj.weight: tensor<8192x8192xbf16>, %self_attn.k_proj.weight: tensor<1024x8192xbf16>, %self_attn.v_proj.weight: tensor<1024x8192xbf16>, %self_attn.o_proj.weight: tensor<8192x8192xbf16>, %post_attention_layernorm.weight: tensor<8192xbf16>, %mlp.gate_proj.weight: tensor<28672x8192xbf16>, %mlp.up_proj.weight: tensor<28672x8192xbf16>, %mlp.down_proj.weight: tensor<8192x28672xbf16>, %self_attn.rotary_emb.cos_sin_cache: tensor<131072x128xbf16>, %x: tensor<1x1x8192xbf16>, %positions: tensor<1x1xint64>, %k_cache: tensor<1x2048x8x128xbf16>, %v_cache: tensor<1x2048x8x128xbf16>) -> (tensor<1x1x8192xbf16>, tensor<1x2048x8x128xbf16>, tensor<1x2048x8x128xbf16>) {
  %input_layernorm = aloi.rms_norm(%x, %input_layernorm.weight) {eps = 1e-05} : tensor<1x1x8192xbf16>
  %self_attn.q_proj = aloi.linear(%input_layernorm, %self_attn.q_proj.weight) : tensor<1x1x8192xbf16>
  %self_attn.split_heads = aloi.split_heads(%self_attn.q_proj) {head_dim = 128} : tensor<1x1x64x128xbf16>
  %self_attn.k_proj = aloi.linear(%input_layernorm, %self_attn.k_proj.weight) : tensor<1x1x1024xbf16>
  %self_attn.split_heads_1 = aloi.split_heads(%self_attn.k_proj) {head_dim = 128} : tensor<1x1x8x128xbf16>
  %self_attn.v_proj = aloi.linear(%input_layernorm, %self_attn.v_proj.weight) : tensor<1x1x1024xbf16>
  %self_attn.split_heads_2 = aloi.split_heads(%self_attn.v_proj) {head_dim = 128} : tensor<1x1x8x128xbf16>
  %self_attn.rotary_emb.rope = aloi.rope(%self_attn.split_heads, %positions, %self_attn.rotary_emb.cos_sin_cache) {is_neox_style = true} : tensor<1x1x64x128xbf16>
  %self_attn.rotary_emb.rope_1 = aloi.rope(%self_attn.split_heads_1, %positions, %self_attn.rotary_emb.cos_sin_cache) {is_neox_style = true} : tensor<1x1x8x128xbf16>
  %self_attn.kv_update = aloi.kv_update(%k_cache, %self_attn.rotary_emb.rope_1, %positions) : tensor<1x2048x8x128xbf16>
  %self_attn.kv_update_1 = aloi.kv_update(%v_cache, %self_attn.split_heads_2, %positions) : tensor<1x2048x8x128xbf16>
  %self_attn.gqa_qk = aloi.gqa_qk(%self_attn.rotary_emb.rope, %self_attn.kv_update) {scale = 0.08838834764831845} : tensor<1x1x64x2048xbf16>
  %self_attn.softmax = aloi.softmax(%self_attn.gqa_qk) : tensor<1x1x64x2048xbf16>
  %self_attn.gqa_sv = aloi.gqa_sv(%self_attn.softmax, %self_attn.kv_update_1) : tensor<1x1x64x128xbf16>
  %self_attn.merge_heads = aloi.merge_heads(%self_attn.gqa_sv) : tensor<1x1x8192xbf16>
  %self_attn.o_proj = aloi.linear(%self_attn.merge_heads, %self_attn.o_proj.weight) : tensor<1x1x8192xbf16>
  %add = aloi.add(%x, %self_attn.o_proj) : tensor<1x1x8192xbf16>
  %post_attention_layernorm = aloi.rms_norm(%add, %post_attention_layernorm.weight) {eps = 1e-05} : tensor<1x1x8192xbf16>
  %mlp.gate_proj = aloi.linear(%post_attention_layernorm, %mlp.gate_proj.weight) : tensor<1x1x28672xbf16>
  %mlp.up_proj = aloi.linear(%post_attention_layernorm, %mlp.up_proj.weight) : tensor<1x1x28672xbf16>
  %mlp.silu = aloi.activation(%mlp.gate_proj) {function = silu} : tensor<1x1x28672xbf16>
  %mlp.mul = aloi.mul(%mlp.silu, %mlp.up_proj) : tensor<1x1x28672xbf16>
  %mlp.down_proj = aloi.linear(%mlp.mul, %mlp.down_proj.weight) : tensor<1x1x8192xbf16>
  %add_1 = aloi.add(%add, %mlp.down_proj) : tensor<1x1x8192xbf16>
  return %add_1, %self_attn.kv_update, %self_attn.kv_update_1
}
